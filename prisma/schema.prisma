generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  APPROVER
}

enum AgentStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  PENDING
  RUNNING
  WAITING_FOR_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum RunStepType {
  INPUT_RECEIVED
  AGENT_DECISION
  TOOL_CALL
  APPROVAL_REQUESTED
  APPROVAL_GRANTED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
}

enum ToolCallStatus {
  SUCCESS
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Stays a real Postgres enum, unlike Integration.provider — a new trigger
// type always needs real new application code (a new inbound endpoint, a
// new payload-normalization step) regardless of whether this is an enum
// or a string, so there's no "avoid a migration for every new plugin"
// argument here the way there was for provider/pipelineKey/actionTool.
// Small, code-defined, closed set — same category as AgentExecutionMode.
enum WorkflowTriggerType {
  EMAIL
  WEBHOOK
}

enum WorkflowAgentRole {
  CLASSIFIER
  HANDLER
}

// TEMPLATE: a platform-provided, plug-and-play starter workflow (e.g.
// "Email Handling", provisioned automatically for every new org — see
// provision-email-workflow.ts) — a business enables/configures it, doesn't
// author it from nothing. CUSTOM: a business built this one themselves
// from /workflows/new, for a process the platform doesn't ship a starter
// for. Both are ordinary Workflow rows with the same shape and the same
// runtime — this only records provenance, it doesn't change how a
// workflow runs.
enum WorkflowSource {
  TEMPLATE
  CUSTOM
}

// LOOP: the original free-form runtime (lib/runtime/agent-runtime.ts) — the
// model decides which tool to call next, turn by turn. HARNESS: a fixed,
// coded pipeline (lib/harness/) — the model is only asked narrow, atomic
// questions (extract these fields; write this reply from these facts); tool
// sequencing is deterministic code, not a model decision. Both are kept as
// real, supported modes rather than replacing one with the other — some
// future agent's job may not fit a fixed pipeline.
enum AgentExecutionMode {
  LOOP
  HARNESS
}

model Organisation {
  id         String   @id @default(cuid())
  // Clerk's Organization id — the real, session-verified identity every
  // request's org context resolves against (lib/organisations/current-organisation.ts).
  // Required: every Organisation row that exists came from a real Clerk
  // sign-in, provisioned lazily on first sight of a not-yet-seen org.
  clerkOrgId String   @unique
  name       String
  // ISO 4217 code (e.g. "GBP", "USD"). Plain string, not an enum — ISO 4217
  // has ~180 codes; a Postgres enum would need a migration per new currency
  // supported. What the app actually accepts is constrained at the
  // application layer instead (lib/currency/currency-symbols.ts).
  currency   String   @default("GBP")
  // Set by the business itself in Settings — this app has no legal team of
  // its own to author real Terms of Service/Privacy Policy text, so these
  // are just outbound links to wherever the business hosts its own,
  // surfaced consistently in the product rather than fabricated content.
  // Null means "not set yet."
  termsUrl   String?
  privacyUrl String?
  // Which connected AI provider Integration ("ollama" or "gemini") every
  // agent run in this org actually calls — see
  // lib/ai/organisation-ai-provider.ts. Plain string, not an enum, same
  // reasoning as currency/Integration.provider: a third provider should
  // never need a migration. Null means "not chosen yet" for a fresh org,
  // or implicitly "ollama" for every org that predates this column, since
  // Ollama was the only provider before it existed and nothing about an
  // existing connection should change under it.
  //
  // A separate column rather than "whichever Integration row is newest"
  // deliberately: unlike picking a default email account, silently
  // guessing which paid API an organisation is currently being billed
  // through is exactly the kind of half-configured state CLAUDE.md §14
  // says must be surfaced, not inferred. Both providers' credentials are
  // kept — connecting Gemini doesn't discard a working Ollama connection —
  // this only decides which one is live.
  activeAiProvider String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users               User[]
  agents              Agent[]
  agentRuns           AgentRun[]
  approvals           Approval[]
  integrations        Integration[]
  workflows           Workflow[]
  customEntityTypes   CustomEntityType[]
  customEntityRecords CustomEntityRecord[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  agentTemplates      AgentTemplate[]
}

// The shape of a business's own data — a landlord's Properties, a law
// firm's Cases, a merchant's Products. Every record type lives here now:
// Product and Customer used to be real tables with real columns, which
// meant every business in every industry carried a retail-shaped schema it
// could not change. They are ordinary seeded types like any other since
// 20260904020000_collapse_catalog_into_record_types (CLAUDE.md §4.3).
//
// Deliberately generic (name + a typed field list) rather than real
// Postgres columns per type: a business's field names can't be known ahead
// of time, and a table per type would mean a migration every time a
// business defines one.
model CustomEntityType {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  fields         Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation         @relation(fields: [organisationId], references: [id])
  records      CustomEntityRecord[]

  @@unique([organisationId, name])
  @@index([organisationId])
}

// One row per record, data held as JSON keyed by the parent
// CustomEntityType's own field names — the record has no fixed columns of
// its own, matching the reasoning on CustomEntityType. organisationId is
// denormalized here (derivable via entityType) so record queries can be
// scoped directly without an extra join, the same trade-off already made
// throughout this schema for tenant isolation checks.
model CustomEntityRecord {
  id             String   @id @default(cuid())
  entityTypeId   String
  organisationId String
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Cascade: deleting a business-defined entity type (e.g. no longer
  // tracking "Property") deletes its records with it — a business
  // removing a catalog type means removing its entries, not leaving them
  // orphaned with no parent type to display or validate them against.
  entityType   CustomEntityType @relation(fields: [entityTypeId], references: [id], onDelete: Cascade)
  organisation Organisation     @relation(fields: [organisationId], references: [id])

  @@index([entityTypeId])
  @@index([organisationId])
}

model User {
  id             String   @id @default(cuid())
  organisationId String
  // Clerk's User id, scoped to this org membership (not globally unique —
  // one Clerk person can belong to more than one organisation via
  // <OrganizationSwitcher/>, each membership gets its own row here).
  clerkUserId    String
  email          String
  name           String
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation     Organisation @relation(fields: [organisationId], references: [id])
  approvalsDecided Approval[]

  // Scoped to organisationId, not globally unique — the same real person
  // (same email, same Clerk user) can be a member of more than one
  // organisation, each with its own row here.
  @@unique([organisationId, email])
  @@unique([organisationId, clerkUserId])
  @@index([organisationId])
}

model Agent {
  id             String      @id @default(cuid())
  organisationId String
  name           String
  description    String
  instructions   String
  model          String
  status         AgentStatus @default(DRAFT)
  version        Int         @default(1)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  executionMode        AgentExecutionMode @default(LOOP)
  // Which lib/harness/pipelines/index.ts entry to run — only meaningful
  // when executionMode is HARNESS. Not a foreign key: pipelines are code,
  // not database rows (CLAUDE.md #24 — no generic workflow-node engine yet).
  pipelineKey          String?
  // Deterministic pre-classification, tried before the LLM classifier
  // (lib/routing/deterministic-classify.ts) — if the input contains one of
  // these words/phrases and no other agent's keywords also match, routing
  // skips the LLM call entirely. Empty means "always ask the classifier."
  keywords             String[]           @default([])
  // HARNESS-only: overrides a pipeline's hardcoded default reply subject
  // line (e.g. Complaints' "Re: your recent experience"). Null means "use
  // the pipeline's default" — existing agents with no template set keep
  // behaving exactly as before this field existed.
  replySubjectTemplate String?
  // "acknowledge_reply"-pipeline-only: business-defined fields to pull out
  // of the message, e.g. [{"name":"caseNumber","description":"the case
  // number if mentioned"}]. A fixed "customerEmail" field is always
  // extracted in addition to these regardless of what's configured here —
  // see acknowledge-reply-pipeline.ts — so a business never has to think
  // about identity extraction, only what's specific to their category.
  // Json, not a related table: this is a small, agent-owned list with no
  // independent lifecycle of its own, same reasoning as messages on
  // AgentRun.
  extractionFields     Json               @default("[]")
  // "acknowledge_reply"-pipeline-only: a composed reply is refused (run
  // FAILED, never proposed for approval) if it contains any of these
  // words/phrases, case-insensitive substring match — see
  // pipeline-guards.ts. Generalizes what was a single hardcoded
  // compensation-promise regex on the old Complaints pipeline into a
  // guardrail any business-defined category can configure for itself.
  // Empty means no guardrail is applied.
  guardrailKeywords    String[]           @default([])
  // HARNESS-only: the tool a pipeline proposes as its terminal action (see
  // lib/harness/propose-action.ts). Not a foreign key, same reasoning as
  // pipelineKey — tools are code, validated at runtime against the real
  // MCP tool registry and this agent's own grants, not a DB relation.
  // "send_email" is the only tool that makes sense here today (the only
  // approval-gated, customer-facing action that exists); this field exists
  // now, ahead of a second one, so adding create_invoice/post_slack_message
  // later (once real integrations exist) is additive to the pipeline layer,
  // not a rewrite of it — same reasoning as the AIProvider abstraction
  // existing before a second AI provider did.
  actionTool           String             @default("send_email")
  // Which connected account actionTool uses — e.g. which of the org's
  // Gmail accounts this category sends from. Null means "the provider's
  // default account" (lib/integrations/integration-service.ts's
  // getDefaultGmailIntegration — whichever was connected first), the
  // same fallback every agent used before this field existed. Not
  // required to be set even once a business has multiple accounts of a
  // provider; it only matters the moment two categories need to use
  // *different* accounts of the same provider.
  actionIntegrationId  String?
  // Generic key-value config bag for pipeline-specific settings that don't
  // yet warrant their own named column — same reasoning as
  // Organisation.currency/Integration.provider being plain strings: a
  // narrowly-named column per future pipeline (the way extractionFields/
  // guardrailKeywords/replySubjectTemplate each are) would mean a
  // migration every time a *new* pipeline needs its own settings shape.
  // Each pipeline defines and validates its own shape for this in
  // application code (e.g. entity-status-signal-pipeline.ts), not the
  // database. Empty object means "not configured."
  pipelineConfig       Json               @default("{}")

  organisation        Organisation    @relation(fields: [organisationId], references: [id])
  actionIntegration   Integration?    @relation(fields: [actionIntegrationId], references: [id])
  runs                AgentRun[]
  tools               AgentTool[]
  workflowMemberships WorkflowAgent[]

  @@index([organisationId])
  @@index([actionIntegrationId])
}

// Which MCP tools this agent may use (CLAUDE.md #9 step 3: "check the
// agent has access to the tool"). Enforced deterministically in
// lib/runtime/agent-runtime.ts before a tool call ever reaches the MCP
// server — a tool absent here is refused even if the model asks for it,
// not just hidden from what's offered.
model AgentTool {
  id       String @id @default(cuid())
  agentId  String
  toolName String

  // Cascade: a tool grant has no independent value once its agent is
  // gone — unlike AgentRun below, deleting one destroys no audit trail.
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, toolName])
  @@index([agentId])
}

// A named, reusable pipeline: one classifier agent that decides which
// handler agent should deal with an inbound item, plus the handler agents
// themselves (see lib/routing/dispatch.ts). Kept deliberately simple (a
// flat classifier + handlers list, not a generic node graph) — CLAUDE.md
// #24 says not to build a full workflow editor yet — but it's a real,
// separate entity so a business can eventually have more than one workflow
// (e.g. a future quote-to-production pipeline) without a schema rewrite.
model Workflow {
  id                   String              @id @default(cuid())
  organisationId       String
  name                 String
  description          String
  trigger              WorkflowTriggerType
  // DRAFT: being built, never dispatched to. ACTIVE: live — at most one
  // workflow per (organisationId, trigger, triggerIntegrationId) may be
  // ACTIVE at a time, enforced in workflow-service.ts's activateWorkflow,
  // not the database — dispatchInboundMessage's workflow lookup uses
  // findFirst, so two ACTIVE workflows on the same (trigger, account)
  // would mean one silently, non-deterministically never receives real
  // traffic. Two workflows on the *same trigger* but *different* bound
  // accounts don't compete at all — each account's traffic is its own.
  // ARCHIVED: retired.
  status               AgentStatus         @default(DRAFT)
  source               WorkflowSource      @default(CUSTOM)
  // TEMPLATE-only: which starter template this came from (currently just
  // "email_handling" — see provision-email-workflow.ts). Not a foreign
  // key, same reasoning as Agent.pipelineKey: identifies which piece of
  // code provisioned this, not a row in a templates table. Null for
  // CUSTOM workflows. A real template *registry* (more than one starter
  // to choose from) is later work — this field exists now so adding one
  // is additive, not a schema change.
  templateKey          String?
  // Which specific connected account this workflow listens on — e.g.
  // exactly which webhook URL/secret, or which of several Gmail accounts.
  // Null means "the generic one for this trigger type" (today's only
  // behavior, still the default): a webhook-triggered workflow with no
  // binding is unreachable (there's no generic webhook URL, only
  // per-account ones — /api/webhooks/[integrationId] always identifies a
  // specific account), so this is effectively required for WEBHOOK in
  // practice, optional for EMAIL where a generic org-wide fallback still
  // makes sense.
  triggerIntegrationId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  organisation       Organisation    @relation(fields: [organisationId], references: [id])
  triggerIntegration Integration?    @relation(fields: [triggerIntegrationId], references: [id])
  members            WorkflowAgent[]

  @@index([organisationId])
  @@index([triggerIntegrationId])
}

model WorkflowAgent {
  id         String            @id @default(cuid())
  workflowId String
  agentId    String
  role       WorkflowAgentRole

  workflow Workflow @relation(fields: [workflowId], references: [id])
  // Cascade: same reasoning as AgentTool.agent — a workflow membership row
  // has no independent value once the agent it points at is gone.
  agent    Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([workflowId, agentId])
  @@index([workflowId])
  @@index([agentId])
}

model AgentRun {
  id             String    @id @default(cuid())
  agentId        String
  organisationId String
  status         RunStatus @default(PENDING)
  input          String
  // Snapshot of the in-progress conversation, saved only when the run
  // pauses for approval — lets resumeRun() pick the loop back up rather
  // than starting the conversation over.
  messages       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  agent        Agent        @relation(fields: [agentId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  steps        RunStep[]
  toolCalls    ToolCall[]
  approvals    Approval[]

  @@index([agentId])
  @@index([organisationId])
}

model RunStep {
  id         String      @id @default(cuid())
  agentRunId String
  stepType   RunStepType
  detail     String?
  toolCallId String?     @unique
  createdAt  DateTime    @default(now())

  // Populated only on steps backed by a real LLM call (AGENT_DECISION
  // today) from AIResponse.usage — null for deterministic steps (TOOL_CALL,
  // INPUT_RECEIVED, etc.), which cost no tokens. Summed on the run detail
  // page so cost is visible per run, not something you rediscover by
  // running a script.
  promptTokens     Int?
  completionTokens Int?

  agentRun AgentRun  @relation(fields: [agentRunId], references: [id])
  toolCall ToolCall? @relation(fields: [toolCallId], references: [id])

  @@index([agentRunId])
}

model ToolCall {
  id         String         @id @default(cuid())
  agentRunId String
  toolName   String
  input      Json
  output     Json?
  status     ToolCallStatus
  error      String?
  createdAt  DateTime       @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id])
  runStep  RunStep?

  @@index([agentRunId])
}

model Approval {
  id                 String         @id @default(cuid())
  agentRunId         String
  organisationId     String
  requestedAction    String
  reason             String
  // The exact tool-call arguments being held back pending approval (e.g.
  // {to, subject, body} for send_email) and the LLM's id for that call, so
  // the approver reviews the real proposed content — not just an abstract
  // "an email will be sent" — and resumeRun can execute precisely this call.
  // Null for any future post-execution-only approval (see policy-engine.ts).
  proposedInput      Json?
  proposedToolCallId String?
  status             ApprovalStatus @default(PENDING)
  requestedAt        DateTime       @default(now())
  approverId         String?
  decidedAt          DateTime?

  agentRun     AgentRun     @relation(fields: [agentRunId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  approver     User?        @relation(fields: [approverId], references: [id])

  @@index([agentRunId])
  @@index([organisationId])
}

// Stores one OAuth token set per organisation per provider. Tokens are
// plaintext for V1 — server-side only, never sent to the browser, never
// committed (CLAUDE.md #22) — see docs/production-notes.md for the
// encryption-at-rest hardening this needs before any real deployment.
// One connected *account*, not one row per provider — a business can
// connect more than one Gmail address (e.g. sales@ and support@ feeding
// different workflows), and future providers (webhook, Slack, ...) may
// have a "many accounts" shape from day one. provider is a plain string,
// not an enum — validated against lib/integrations/integration-registry.ts
// at the application layer, same reasoning as Agent.pipelineKey/actionTool
// and Organisation.currency: a Postgres enum would need a migration for
// every new provider, forever.
model Integration {
  id             String    @id @default(cuid())
  organisationId String
  provider       String
  // Human-identifiable label for this specific account — the connected
  // Gmail address today. Also the dedup key: reconnecting the same Gmail
  // account updates its row rather than creating a duplicate (see the
  // unique constraint below), while a different address becomes a
  // genuinely new account.
  name           String
  // Non-secret, provider-specific metadata (e.g. Gmail's connected email —
  // duplicated from `name` deliberately, so `name` can be treated as pure
  // UI label without every reader needing to know it's also meaningful
  // data for Gmail specifically). Plaintext — nothing sensitive belongs
  // here, see `credentials` for that.
  config         Json      @default("{}")
  // One encrypted blob (see lib/crypto/token-cipher.ts), not per-field
  // columns — holds whatever secret shape a given provider needs as
  // serialized JSON before encryption (Gmail: {accessToken, refreshToken}).
  // Nullable: not every future provider needs stored credentials (e.g. an
  // inbound-only webhook might not).
  credentials    String?
  // OAuth-style expiry, kept as a real column rather than buried in
  // `config` — refresh-before-expiry is a recurring pattern across OAuth
  // providers (Gmail today, plausibly Slack/Xero/HubSpot later), not a
  // Gmail peculiarity, so keeping it queryable/typed here lets that logic
  // stay provider-agnostic. Null for providers with no expiry concept.
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation       Organisation @relation(fields: [organisationId], references: [id])
  triggeredWorkflows Workflow[]
  actionForAgents    Agent[]

  @@unique([organisationId, provider, name])
  @@index([organisationId])
}

// A business's own unstructured knowledge — policies, SOPs, price lists,
// FAQs. Deliberately separate from CustomEntityType/Record, which is
// structured data: an invoice is looked up exactly by number and summed,
// a refund policy is retrieved by meaning. Vector search would be wrong
// for the former and is the whole point of the latter
// (docs/agent-step-engine-design.md, catalog reform).
//
// Before this existed, the only place for "how this business does things"
// was Agent.instructions, which is concatenated into every single LLM
// call — so guidance got linearly more expensive as it grew. Retrieval
// carries only the chunks a given run actually needs.
model KnowledgeDocument {
  id             String   @id @default(cuid())
  organisationId String
  title          String
  // Where the text came from — "pasted" or "upload". A plain string, not
  // an enum, same reasoning as Integration.provider: a new source
  // shouldn't need a migration.
  source         String   @default("pasted")
  // The whole original text, kept alongside its chunks so a document can
  // be re-chunked later (a better splitter, a different chunk size)
  // without asking the business to paste it again.
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id])
  chunks       KnowledgeChunk[]

  @@index([organisationId])
}

model KnowledgeChunk {
  id             String @id @default(cuid())
  documentId     String
  organisationId String
  // Order within the source document, so retrieved chunks can be shown
  // and read back in their original sequence.
  position       Int
  content        String
  // pgvector, 768 dimensions — nomic-embed-text's output size. Typed
  // Unsupported because Prisma has no native vector type: the column is
  // created and indexed by migration, and every read/write of it goes
  // through raw SQL in lib/knowledge/. Nullable so a chunk can exist
  // before its embedding is generated.
  embedding      Unsupported("vector(768)")?
  createdAt      DateTime                   @default(now())

  // Cascade: a chunk has no meaning without its document, and unlike a
  // run's audit trail there's nothing here worth preserving separately.
  document     KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organisation Organisation      @relation(fields: [organisationId], references: [id])

  @@index([documentId])
  @@index([organisationId])
}

// A named, reusable step programme a business can install onto a new agent
// and then edit freely (docs/agent-step-engine-design.md §6).
//
// This is where verticals live. "Quote Handling" is a template, not a
// platform feature — the whole point of CLAUDE.md §3 is that a specific
// business process must never become a first-class primitive that every
// unrelated business has to scroll past.
//
// Database rows rather than code constants so a business can save its own
// working agent as a reusable starting point, not only install ones that
// shipped with the product. organisationId is nullable for exactly that
// reason: null means a built-in template visible to everyone, set means a
// business's own private one.
model AgentTemplate {
  id             String  @id @default(cuid())
  organisationId String?
  name           String
  description    String
  // The step programme, same shape Agent.pipelineConfig holds and
  // validated by the same schema (lib/harness/steps/schema.ts) — a
  // template that wouldn't run is not a template.
  steps          Json    @default("{}")
  // Tools the steps need. Installing a template pre-ticks these rather
  // than granting them silently: a tool an agent holds without anyone
  // choosing it is exactly what the per-agent grant model exists to stop.
  suggestedTools String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
}
