# Local PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://aperator:aperator@localhost:5433/aperator

# AI provider (Ollama) — no longer configured here. It's a per-organisation
# Connection now (Settings → AI Provider), not a global env var: every
# organisation must explicitly connect its own instance before any of its
# agents can run, rather than silently sharing one operator-configured
# instance. See lib/ai/organisation-ai-provider.ts.

# Google integrations (Gmail, Google Drive) — from a Google Cloud project
# with the Gmail API and Drive API enabled and an OAuth consent screen
# configured. Same client id/secret backs both; each product calls back to
# its own route, so each needs its own redirect URI. Optional: the app runs
# fine without these, only /settings' "Connect Gmail" / "Connect Google
# Drive" flows need them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/integrations/google-drive/callback

# Slack integration (notify_channel) — from a Slack App (api.slack.com) with
# Bot Token Scopes chat:write and chat:write.public, and this redirect URL
# added under OAuth & Permissions. Optional: only /settings' "Add Slack
# account" flow needs these.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback

# Microsoft integrations (Outlook Mail, Teams, Outlook Calendar, SharePoint)
# — one Azure AD / Entra ID app registration (portal.azure.com > App
# registrations) backs all four: same client id/secret, delegated Graph API
# permissions Mail.Read, Mail.Send, ChannelMessage.Send, Calendars.ReadWrite,
# Sites.ReadWrite.All, User.Read, offline_access. Each product calls back to
# its own route, so each needs its own redirect URI added under the app's
# Authentication settings. Optional: the app runs fine without these, only
# /settings' "Add Outlook account" / "Add Teams account" / "Add Outlook
# Calendar account" / "Add SharePoint account" flows need them.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OUTLOOK_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback
MICROSOFT_TEAMS_REDIRECT_URI=http://localhost:3000/api/integrations/teams/callback
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/outlook-calendar/callback
MICROSOFT_SHAREPOINT_REDIRECT_URI=http://localhost:3000/api/integrations/sharepoint/callback

# Used to build absolute links back into the app from places with no HTTP
# request to derive a base URL from (e.g. a notify_channel message linking
# to /approvals). Optional — the link is just omitted without it.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth (Phase B) — from a Clerk application's dashboard (API Keys page).
# Required: every page resolves its organisation/user via Clerk, so the app
# won't run without these. Enable the Organizations feature in the Clerk
# dashboard too, or /select-organisation will error.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Encrypts Gmail OAuth tokens at rest (lib/crypto/token-cipher.ts). Generate
# with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Verifies requests to /api/cron/run-due-tasks actually came from Vercel
# Cron (see vercel.json's crons entry), not an open endpoint anyone could
# hit to force every organisation's routines to fire early. Optional: unset
# means the route accepts any request, which is fine locally but should
# always be set in production. Generate with: openssl rand -base64 32
CRON_SECRET=
